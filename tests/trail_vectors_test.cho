edition 5;

import std.test;
import trail;

// GENERATED by tests/gen_trail_vectors.py from lex-trail's spec/vectors.json. Do not edit by hand.
//
// Every event id and anchor digest below is lex-trail's, not computed by this engine.

fn expect_hex[&o, &w](out: &o [byte], want: &w [byte]) -> [] int {
    test.assert_eq(len(want), 64);
    var i = 0;
    while i < 64 {
        test.assert_eq(int_of(out[i]), int_of(want[i]));
        i = i + 1;
    }
    return 0;
}

fn expect_id[&k, &p, &l, &w](kind: &k [byte], parent: &p [byte], payload: &l [byte], ts_ms: int, want: &w [byte]) -> [] int {
    region a {
        let out = alloc_slice[a](64, byte_of(0));
        test.assert_eq(trail.check_event(kind, parent, payload, ts_ms), 0);
        trail.event_id(kind, parent, payload, ts_ms, out);
        expect_hex(out, want);
    }
    return 0;
}

fn expect_anchor[&d, &w](ids: &d [byte], count: int, want: &w [byte]) -> [] int {
    region a {
        let out = alloc_slice[a](64, byte_of(0));
        test.assert_eq(trail.anchor_digest(ids, count, out), 0);
        expect_hex(out, want);
    }
    return 0;
}

fn test_event_0() -> [] int {
    expect_id("meter.reading", "", "{\"wh\":105500}", 1788000000000, "c4a796cbbe6022d02f6cc33d9364e704a4f69a495bacf1774baee477b4bd60ea");
    return 0;
}

